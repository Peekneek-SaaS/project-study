

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Folder {
  id String @id @default(cuid())
  userId String
  name String
  parentId  String?
  parent Folder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  Folder[] @relation("FolderTree")
  documents Document[]
  isLocked Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, parentId])
}

/// Where a document is on its way to being workable.
///
/// The order is the order it happens in: the bytes arrive (`UPLOADING`), the
/// row is written and the workspace job is queued (`QUEUED`), the job picks it
/// up (`BUILDING`), and the board and notes exist (`READY`).
///
/// `QUEUED` and `BUILDING` are separate states rather than one "working"
/// because they fail differently and the user can act on the difference: a
/// document stuck in `QUEUED` means nothing is consuming the queue, while one
/// stuck in `BUILDING` means the job itself is wedged.
enum DocumentStatus {
  UPLOADING
  QUEUED
  BUILDING
  READY
  FAILED
}

model Document {
  id String @id @default(cuid())
  userId    String
  folderId  String?
  folder    Folder?        @relation(fields: [folderId], references: [id], onDelete: SetNull)
  name      String
  pdfUrl    String
  status    DocumentStatus @default(UPLOADING)
  isLocked Boolean @default(true)

  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  /// The board tied to this document, once per-document boards are built. The
  /// back half of `Board.documentId` — no column of its own.
  board     Board?

  /// Notes taken against this document, once per-document notes are built.
  /// Plural where `board` is singular: a document gets one canvas, but as many
  /// notes as it earns.
  stickyNotes StickyNote[]

  @@index([userId, folderId])
}

/// An Excalidraw scene.
///
/// `documentId` is what a board is *about*: null means it stands on its own,
/// and set means it belongs to a document. Only standalone boards are built
/// for now — nothing writes a `documentId` yet — but the column and its
/// uniqueness are here so the per-document ones need a feature rather than a
/// migration. `@unique` is what makes it at most one board per document, and
/// the cascade means deleting a document takes its board with it.
model Board {
  id         String    @id @default(cuid())
  userId     String
  documentId String?   @unique
  name       String    @default("Untitled Board")
  /// The whole Excalidraw scene: `{ elements, appState, files }`, as written
  /// by `serializeAsJSON`. Opaque here on purpose — its shape is Excalidraw's
  /// to change, and nothing in the database reads into it.
  snapshot   Json
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  document   Document? @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([userId, documentId])
}

/// One sticky note.
///
/// `documentId` works as it does on `Board` — null means standalone, set means
/// it belongs to a document — but without `@unique`, because a document can
/// collect as many notes as it likes. Only standalone notes are built for now;
/// nothing writes a `documentId` yet.
///
/// Appearance lives on the row rather than in a stylesheet because it is the
/// user's, not the designer's: `color`, `textColor`, `fontSize` and `showGrid`
/// are all changeable per note at any time. They are stored as palette *keys*
/// rather than as CSS, so a note picked in light mode still reads correctly in
/// dark mode — see `note-appearance.ts`, which owns the names.
model StickyNote {
  id         String    @id @default(cuid())
  userId     String
  documentId String?
  content    String    @default("")
  color      String    @default("amber")
  textColor  String    @default("ink")
  fontSize   Int       @default(14)
  showGrid   Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  document   Document? @relation(fields: [documentId], references: [id], onDelete: Cascade)

  /// The grid reads newest first within a day, and groups by day — so the
  /// index carries `createdAt` rather than `updatedAt`. Editing an old note
  /// leaves it under the date it was written, which is what makes "Yesterday"
  /// mean anything.
  @@index([userId, documentId, createdAt])
}
