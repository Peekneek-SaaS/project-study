generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Folder {
  id        String     @id @default(cuid())
  userId    String
  name      String
  parentId  String?
  parent    Folder?    @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  Folder[]   @relation("FolderTree")
  documents Document[]
  isLocked  Boolean    @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, parentId])
}

/// Where a document is on its way to being workable.
///
/// The order is the order it happens in: the bytes arrive (`UPLOADING`), the
/// row is written and the workspace job is queued (`QUEUED`), the job picks it
/// up (`BUILDING`), and the board and notes exist (`READY`).
///
/// `QUEUED` and `BUILDING` are separate states rather than one "working"
/// because they fail differently and the user can act on the difference: a
/// document stuck in `QUEUED` means nothing is consuming the queue, while one
/// stuck in `BUILDING` means the job itself is wedged.
enum DocumentStatus {
  UPLOADING
  QUEUED
  BUILDING
  READY
  FAILED
}

model Document {
  id       String         @id @default(cuid())
  userId   String
  folderId String?
  folder   Folder?        @relation(fields: [folderId], references: [id], onDelete: SetNull)
  name     String
  pdfUrl   String
  status   DocumentStatus @default(UPLOADING)
  isLocked Boolean        @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The board tied to this document, once per-document boards are built. The
  /// back half of `Board.documentId` — no column of its own.
  board Board?

  /// Notes taken against this document, once per-document notes are built.
  /// Plural where `board` is singular: a document gets one canvas, but as many
  /// notes as it earns.
  stickyNotes StickyNote[]

  /// Notes written *into* the document — pinned to a page and a place on it.
  ///
  /// Separate from `stickyNotes` rather than a flag on them, because the two
  /// are different objects that happen to hold similar text. A sticky note is
  /// loose paper: it belongs to the document but not to any part of it, and it
  /// is read on the notes wall. An annotation cannot exist without a page and a
  /// rectangle on that page — it is a mark *on* a sentence, and it is read by
  /// clicking the dot sitting over that sentence. Folding them together would
  /// mean every notes query filtering out the anchored ones and every
  /// annotation carrying four columns the notes never use.
  annotations DocumentAnnotation[]

  /// What the AI has read out of this document, once it has been through
  /// `process-document-content`. Singular and optional: a document has one
  /// reading of itself, and does not have it until the job has run.
  content DocumentContent?

  /// The passages that reading was cut into. Reachable through `content` as
  /// well, but held here too so a chunk can be found by document without
  /// joining through it — which is what every search does.
  chunks DocumentChunk[]

  /// The conversation held against this document. At most one — see `Chat`.
  chat Chat?

  /// Tasks written against this document. Plural, like the notes: a document
  /// collects as many things to do as it earns. Unlike the notes, these are
  /// *not* hidden from the rest of the app — a task is still due on a day, so
  /// it appears in that day on the todo page and counts toward the header
  /// calendar's dots. See `Todo.documentId`.
  todos Todo[]

  @@index([userId, folderId])
}

/// How far the AI has got with reading a document.
///
/// Deliberately separate from `DocumentStatus`, which tracks the board and the
/// notes. The two jobs run independently and fail independently: a document
/// whose workspace built fine can still be unreadable to the model, and one the
/// model read perfectly can have had its board build wedge. Folding them into
/// one column would mean a failure in either one hiding the other's success.
enum ContentStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

/// A document as the AI understands it: the whole of what chat knows.
///
/// One row per document, holding the *document-level* reading — what this
/// thing is, what it covers, how it is laid out. The text itself lives next
/// door in `DocumentChunk`, because that is what gets searched and this is what
/// gets shown.
///
/// The universal chat and a document's own chat read the same rows. There is no
/// second, combined copy of anything: "everything the user has uploaded" is
/// just this table without a `documentId` filter, which is why processing
/// happens exactly once per document.
model DocumentContent {
  id         String   @id @default(cuid())
  documentId String   @unique
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  /// Denormalised from `Document` on purpose. Every retrieval query filters by
  /// owner first, and reaching through the relation to prove ownership would
  /// put a join in front of the one check that must never be skipped.
  userId String

  status ContentStatus @default(PENDING)

  /// The document's real title, as the model read it off the page — which is
  /// very often not the file name. "bio-ch4-final-v2.pdf" is what the user
  /// called it; "Cell Structure and Function" is what it is, and the second one
  /// is what a citation should say.
  title String?

  /// The field it belongs to — "Biology", "Macroeconomics". What lets the
  /// universal chat say *which* subject an answer came from when three
  /// documents all have a chapter 4.
  subject String?

  /// A few sentences on what the document covers. Cheap enough to put in front
  /// of the model for every universal question, which is what makes the model
  /// able to pick the right document to search before it searches it.
  summary String @default("")

  /// The chapters and sections, with the pages they run over, as
  /// `{ title, pageStart, pageEnd }[]`. Json rather than a table: it is read
  /// whole, written once, and never queried into.
  outline Json?

  /// Topic keywords, for the same reason as `summary` — a router hint, not a
  /// search index.
  topics String[] @default([])

  /// How many pages the extractor found. The ceiling on any page a citation is
  /// allowed to name, and what tells `readPages` when it has been asked for
  /// something past the end.
  pageCount Int @default(0)

  /// Which provider and model actually produced this, after the fallback chain
  /// had its say. Kept because "the answer is odd" and "the third provider
  /// wrote it" are the same investigation, and without this there is no way to
  /// tell the two apart after the fact.
  provider String?
  model    String?

  /// Why it failed, in the user's words rather than a stack trace. Shown on the
  /// document's chat tab, so it has to be something a person can act on.
  error String?

  processedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  chunks DocumentChunk[]

  @@index([userId, status])
}

/// One searchable passage of a document.
///
/// The unit of retrieval and the unit of citation, which is why it carries a
/// page range rather than an offset: an answer has to be able to say "page 5",
/// and a chunk that only knows its character position in a blob cannot.
///
/// Chunks span a range rather than sitting on a single page because passages do
/// — a paragraph that starts at the foot of page 4 and finishes at the head of
/// page 5 is one thought, and splitting it at the page break is how a search
/// finds half of it.
model DocumentChunk {
  id String @id @default(cuid())

  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  contentId String
  content   DocumentContent @relation(fields: [contentId], references: [id], onDelete: Cascade)

  /// As on `DocumentContent`, and for the same reason: search filters by owner
  /// before it does anything else.
  userId String

  /// Position in the document, from zero. What puts search results back in
  /// reading order, and what `readPages` walks.
  index Int

  /// Inclusive, 1-based — the numbers printed on the page, not array indices.
  /// A citation reads these straight out, so they are kept in the form a person
  /// would say them.
  pageStart Int
  pageEnd   Int

  /// Which chapter or section this fell in, resolved from the outline when the
  /// document was processed. Null when the model could not make out a
  /// structure, in which case citations fall back to pages alone.
  section String?

  text String

  createdAt DateTime @default(now())

  /// The full-text index this is searched by.
  ///
  /// Never written by application code — a Postgres trigger recomputes it from
  /// `text` on every insert and update, so it cannot fall out of step with the
  /// passage it describes. `Unsupported` because Prisma has no `tsvector` type;
  /// that also keeps it out of the generated create and update inputs, which is
  /// what makes "never written by application code" true by construction rather
  /// than by discipline.
  ///
  /// A trigger and not a `GENERATED ALWAYS AS` column, which is the obvious way
  /// to do this and does not survive contact with Prisma: the migration engine
  /// reads a generation expression as a column default, sees a default the
  /// datamodel does not declare, and emits `ALTER COLUMN ... DROP DEFAULT` on
  /// every `migrate dev` — a statement Postgres refuses on a generated column.
  /// Triggers are invisible to the differ, so this arrangement produces no
  /// drift at all. See the migration that installs it.
  searchVector Unsupported("tsvector")?

  /// Reading order within a document, and the index a document-scoped search
  /// narrows on before it ranks.
  @@index([documentId, index])
  /// The universal search's first cut: everything this user owns.
  @@index([userId])
  /// The index the whole retrieval layer rests on — GIN over the vector above,
  /// so `@@` is a lookup rather than a scan of every passage the user owns.
  ///
  /// Declared here rather than created in raw SQL, and that is the load-bearing
  /// part: an index Prisma does not know about is one it drops the next time it
  /// diffs the database. Naming the operator class explicitly is what lets it
  /// describe an index on a type it otherwise has no name for.
  @@index([searchVector(ops: raw("tsvector_ops"))], type: Gin)
}

/// Which documents a conversation can see.
///
/// The whole difference between the two chat surfaces, in one column. A
/// `UNIVERSAL` chat searches everything its owner has uploaded and cites the
/// document by name; a `DOCUMENT` chat searches one and refuses questions that
/// fall outside it. The tools handed to the model differ by this and nothing
/// else — see `chat/server/tools.ts`.
enum ChatScope {
  UNIVERSAL
  DOCUMENT
}

/// A conversation.
///
/// `documentId` is both the scope's subject and its uniqueness: `@unique` on a
/// nullable column means at most one chat per document — a document's chat is a
/// place you return to, not a thing you accumulate — while any number of
/// universal chats can sit alongside it, because Postgres does not consider two
/// nulls equal. That is what lets the document chat live at the document's own
/// URL with no id of its own, exactly as the drive's work page does.
model Chat {
  id     String    @id @default(cuid())
  userId String
  scope  ChatScope @default(UNIVERSAL)

  documentId String?   @unique
  document   Document? @relation(fields: [documentId], references: [id], onDelete: Cascade)

  /// Written from the first question rather than asked for. A dialog demanding
  /// a title before the user has said anything is a dialog in the way of the
  /// thing they came to do; renaming later is one click.
  title String @default("New chat")

  /// Which provider this conversation was last held with, so reopening it picks
  /// up where it left off instead of snapping back to the default. Per chat and
  /// not per user: a document being read in one provider's voice should not
  /// change what the next chat opens on.
  provider String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages ChatMessage[]

  /// Where to pick this conversation back up.
  ///
  /// Answering happens in a durable Trigger.dev run rather than inside a
  /// request, so a turn outlives the tab that started it. These three fields are
  /// what let a *different* tab — or the same one after a refresh, or tomorrow —
  /// attach to that run and carry on watching it stream, instead of finding a
  /// finished answer sitting there with no sign of how it arrived.
  ///
  /// `lastEventId` is the cursor into the run's output stream: it is what makes
  /// reconnecting resume rather than replay. It is valid for the lifetime of the
  /// session and deliberately kept across run boundaries — clearing it early
  /// makes a reconnect start from zero and close on the previous turn's stale
  /// completion record.
  sessionRunId String?
  lastEventId  String?

  /// Whether a turn is being written *right now*.
  ///
  /// The one thing the three fields above cannot say. They are written when a
  /// turn finishes and are then true forever — a session outlives its runs by
  /// design — so "this chat has a session" is not "this chat is mid-answer".
  /// Resuming on the first of those means every visit to every past
  /// conversation reopens a stream with nothing to say, and the page waits on
  /// it: a spinner over a finished answer, and a Stop button where Send
  /// belongs.
  ///
  /// Set by the run itself, on both edges — which is what makes it survive the
  /// tab being closed mid-answer, the case a browser-side flag cannot cover.
  isStreaming Boolean @default(false)

  /// The session-scoped token the browser reconnects with.
  ///
  /// Not a secret in the ambient sense — it is scoped to this one chat's session
  /// and expires — but it is still a credential, so it is only ever handed to
  /// the owner of the row and is re-minted server-side when it lapses.
  sessionToken String?

  /// The recents list: this user's universal chats, most recently spoken to
  /// first. `updatedAt` and not `createdAt`, because a chat returned to after a
  /// week belongs at the top.
  @@index([userId, scope, updatedAt])
}

/// One turn in a conversation, stored the way the client draws it.
///
/// `parts` is an AI SDK `UIMessage`'s parts array, verbatim — text, reasoning,
/// tool calls and their results, all of it. Kept whole rather than flattened to
/// a string because a reopened chat has to look like the one that was left: the
/// sources the model cited and the searches it ran are part of the answer, and
/// a schema that only kept the prose would throw them away.
///
/// Json, so the shape stays the SDK's to define. Nothing in the database reads
/// into it.
model ChatMessage {
  id     String @id @default(cuid())
  chatId String
  chat   Chat   @relation(fields: [chatId], references: [id], onDelete: Cascade)

  /// `user` or `assistant`. A string rather than an enum: it is the SDK's
  /// vocabulary, and a role it adds should not need a migration here.
  role String

  parts Json

  /// Which provider answered this particular turn. Per message, not per chat,
  /// because the picker can be changed mid-conversation — and when it is, the
  /// transcript should be able to say which voice said what.
  provider String?

  createdAt DateTime @default(now())

  @@index([chatId, createdAt])
}

/// An Excalidraw scene.
///
/// `documentId` is what a board is *about*: null means it stands on its own,
/// and set means it belongs to a document. Only standalone boards are built
/// for now — nothing writes a `documentId` yet — but the column and its
/// uniqueness are here so the per-document ones need a feature rather than a
/// migration. `@unique` is what makes it at most one board per document, and
/// the cascade means deleting a document takes its board with it.
model Board {
  id         String    @id @default(cuid())
  userId     String
  documentId String?   @unique
  name       String    @default("Untitled Board")
  /// The whole Excalidraw scene: `{ elements, appState, files }`, as written
  /// by `serializeAsJSON`. Opaque here on purpose — its shape is Excalidraw's
  /// to change, and nothing in the database reads into it.
  snapshot   Json
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  document   Document? @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([userId, documentId])
}

/// One sticky note.
///
/// `documentId` works as it does on `Board` — null means standalone, set means
/// it belongs to a document — but without `@unique`, because a document can
/// collect as many notes as it likes. Only standalone notes are built for now;
/// nothing writes a `documentId` yet.
///
/// Appearance lives on the row rather than in a stylesheet because it is the
/// user's, not the designer's: `color`, `textColor`, `fontSize` and `showGrid`
/// are all changeable per note at any time. They are stored as palette *keys*
/// rather than as CSS, so a note picked in light mode still reads correctly in
/// dark mode — see `note-appearance.ts`, which owns the names.
model StickyNote {
  id         String    @id @default(cuid())
  userId     String
  documentId String?
  content    String    @default("")
  color      String    @default("amber")
  textColor  String    @default("ink")
  fontFamily String    @default("sans")
  fontSize   Int       @default(14)
  showGrid   Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  document   Document? @relation(fields: [documentId], references: [id], onDelete: Cascade)

  /// The grid reads newest first within a day, and groups by day — so the
  /// index carries `createdAt` rather than `updatedAt`. Editing an old note
  /// leaves it under the date it was written, which is what makes "Yesterday"
  /// mean anything.
  @@index([userId, documentId, createdAt])
}

/// One note written onto a place in a document.
///
/// Created by selecting text in the PDF and choosing to comment on it, and read
/// by clicking the dot left behind over that text.
model DocumentAnnotation {
  id         String   @id @default(cuid())
  userId     String
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  /// Which page the selection was on, 1-based, as the reader counts them.
  pageNumber Int

  /// Where on that page, as fractions of the page box between 0 and 1.
  ///
  /// Fractions rather than pixels, and that is the whole reason annotations
  /// survive being looked at. The viewer draws a page at whatever size the
  /// panel, the zoom and the device pixel ratio work out to, and none of those
  /// are stable: dragging the divider, pressing zoom, or opening the same
  /// document on a phone all produce a different pixel box for the same page.
  /// A fraction of the box is the same fraction in every one of them, so the
  /// dot lands on the same sentence whatever size that sentence is drawn at.
  ///
  /// The selection's *bounding* box — every line it touches, as one rectangle.
  ///
  /// Kept alongside `rects` rather than replaced by it, because the two answer
  /// different questions. This one is "roughly where on the page is this",
  /// which is what an index, a sort or a fallback wants, and it is four plain
  /// columns a query can compare. `rects` is what actually gets painted.
  x      Float
  y      Float
  width  Float
  height Float

  /// One rectangle per line the selection covers, as `{x,y,width,height}[]`.
  ///
  /// A range that runs over three lines has three of these, and painting them
  /// is the difference between marking the words and marking the paragraph:
  /// the bounding box above spans from the start of the first line to the end
  /// of the last, which on a wrapped selection is a block covering text that
  /// was never selected.
  ///
  /// Json rather than a table: they are read whole, written once, never queried
  /// into, and there are two or three of them. Nullable so rows written before
  /// this existed still render — the reader falls back to the bounding box,
  /// which is what they were drawn as anyway.
  rects Json?

  /// The words that were selected, kept as written.
  ///
  /// Not used to find the anchor — the fractions above do that — but a note
  /// that says only "this is wrong" is useless three weeks later without the
  /// sentence it was pointing at, and the page underneath may by then be
  /// scrolled somewhere else. Shown at the head of the note and on the marker's
  /// tooltip.
  quote String @default("")

  /// The note itself, in the same HTML the sticky notes store, so the same
  /// editor and the same modal can read and write it.
  content String @default("")

  /// Appearance, matching `StickyNote` field for field — see the notes there.
  /// The colour is also what the dot on the page is painted.
  color      String  @default("amber")
  textColor  String  @default("ink")
  fontFamily String  @default("sans")
  fontSize   Int     @default(14)
  showGrid   Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Every read is "the annotations on this document", and the viewer asks page
  /// by page as it renders them.
  @@index([userId, documentId, pageNumber])
}

/// How much a todo is shouting.
///
/// `NONE` is a real member rather than a null, because "no priority" is a thing
/// the filter has to be able to ask for and a thing the row has to be able to
/// be set back to. A nullable column would make the first of those a special
/// case in every query and the second indistinguishable from "never said".
///
/// Ordered urgent-first in the UI, but stored as names rather than numbers: the
/// set is small and unlikely to grow, and a number would need a lookup table
/// living somewhere else to mean anything.
enum TodoPriority {
  NONE
  LOW
  MEDIUM
  HIGH
  URGENT
}

/// One task, filed under the day it is meant to happen on.
///
/// `dueDate` is a `DATE` and not a timestamp, and that is the whole design: a
/// todo belongs to a *calendar day* the user picked, not to an instant. Storing
/// it as a timestamp would make "which day is this under" a question about
/// timezones — the same row would sit under different headings for the same
/// person in two places — and the headings are the entire structure of this
/// page. As a `DATE` it is the day it says it is, everywhere, and the router
/// hands it to the client as a `yyyy-MM-dd` string so no clock is consulted on
/// the way. See `lib/todo-dates.ts`, which owns that format.
///
model Todo {
  id     String @id @default(cuid())
  userId String

  /// The document this task is about, or null for one that stands on its own.
  ///
  /// Works as it does on `StickyNote` — null is standalone, set is owned by a
  /// document, and the cascade means deleting a document takes its tasks with
  /// it — with one deliberate difference: a document's notes are *only* on its
  /// work page, while a document's tasks are on the todo page as well.
  ///
  /// That difference is the point rather than an inconsistency. A note is a
  /// thing you wrote *in* a place and go back to that place to read; a task is
  /// a thing you have to do on a day, and a planner that quietly omitted the
  /// tasks filed against your documents would be lying about the day. So there
  /// is no `documentId: null` filter on `list` — the work page's tab narrows to
  /// one document, and the todo page shows the lot, badged with where each came
  /// from.
  documentId String?
  document   Document? @relation(fields: [documentId], references: [id], onDelete: Cascade)

  title String

  /// The calendar day this is filed under. See above for why it is a `DATE`.
  dueDate DateTime @db.Date

  priority TodoPriority @default(NONE)

  completed   Boolean   @default(false)
  /// When it was ticked. Kept apart from `completed` because it answers a
  /// different question — the flag says whether, this says when — and because
  /// `updatedAt` cannot stand in for it: editing the title of a finished todo
  /// would move the moment it was finished.
  completedAt DateTime?

  /// How long the user expects this to take, in seconds. Null means untimed,
  /// which is most todos — the timer is an option, not a requirement.
  ///
  /// A duration and not a deadline: the user is asked "how long will this
  /// take", so what is stored is the answer to that question. Turning it into
  /// an end instant at write time would freeze a countdown that has not been
  /// started yet, and there would be no way back to the number they picked.
  timerSeconds Int?

  /// When the running stretch began, or null when the timer is not running.
  /// This is the only thing that distinguishes running from paused.
  timerStartedAt DateTime?

  /// Seconds banked from stretches that have already been stopped. The
  /// countdown is `timerSeconds - timerElapsed - (now - timerStartedAt)`, which
  /// is what makes pause and resume survive a reload: nothing is being counted
  /// in a browser somewhere, the two columns say everything.
  timerElapsed Int @default(0)

  /// Where this sits among the other todos of its day. Hand-ordered rather than
  /// by time, so a task added at the end of the day can still belong at the top
  /// of it.
  position Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The one query this page makes: one user's todos across a range of days,
  /// each day in its own order. Every column the list orders by is in the
  /// index, so a window of days is a scan of exactly that window.
  @@index([userId, dueDate, position])
  /// The work page's tab: one document's tasks, in the order that panel reads
  /// them. Its own index rather than a filter on the one above, which leads
  /// with a column this query does not constrain.
  @@index([userId, documentId, dueDate])
}

/// Which plan an account is on.
///
/// A tier and not a set of booleans, because every gate in the app asks the
/// same question — "is this account at least X" — and an ordered enum answers
/// it with a comparison rather than with a table of capabilities that has to
/// be kept in step. What each tier actually grants lives in `billing/lib/plans`
/// so the marketing page and the server read the same numbers.
enum PlanTier {
  FREE
  STUDY
  PRO
}

/// How often the subscription renews. Mirrors Polar's `recurring_interval`.
enum BillingPeriod {
  MONTHLY
  YEARLY
}

/// Where a subscription is in its life, as Polar tells us.
///
/// Deliberately fewer states than Polar has: `incomplete`, `incomplete_expired`
/// and `unpaid` all mean the same thing to this app — the account is not
/// entitled — so they collapse into `INACTIVE` rather than spreading three more
/// cases through every check. `PAST_DUE` is kept apart because it is the one
/// state where access continues while the payment is retried, and the UI has
/// something to say about it.
enum SubscriptionState {
  INACTIVE
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

/// What an account is allowed to spend, and what it has spent.
///
/// One row per user, holding both halves of billing: the mirror of the Polar
/// subscription, written by the webhook, and the credit wallet, written by the
/// app. They are together rather than in two tables because of who reads them
/// and how often — every chat turn and every upload asks "what tier, how many
/// credits" in the same breath, and that should be one indexed read rather than
/// a join or two round trips.
///
/// The row is created lazily on first read, so signing up touches nothing here
/// and an account that never opens the app never gets a row.
///
/// Polar is the source of truth for *what was paid*; this table is the source
/// of truth for *what was used*. Nothing here is ever trusted from the client:
/// the webhook writes the subscription half and the server writes the wallet
/// half, and both are keyed by the Clerk user id that Polar carries back as
/// `external_customer_id`.
model BillingAccount {
  id     String @id @default(cuid())
  userId String @unique

  tier   PlanTier          @default(FREE)
  state  SubscriptionState @default(INACTIVE)
  period BillingPeriod?

  /// Polar's own ids, kept so a support question can be answered without
  /// guessing which customer is which. Nullable because a free account has
  /// never been to a checkout.
  polarCustomerId     String?
  polarSubscriptionId String? @unique
  polarProductId      String?

  /// When the paid period ends — renewal for an active subscription, and the
  /// date access actually stops for a cancelled one. Access is granted up to
  /// this instant regardless of `state`, which is what makes "cancel" mean
  /// "do not renew" rather than "cut me off now".
  currentPeriodEnd DateTime?

  /// Whether the customer has asked not to renew. Kept separate from `state`
  /// because Polar keeps a cancelled-but-not-yet-expired subscription `active`,
  /// and the banner the user sees depends on this rather than on the status.
  cancelAtPeriodEnd Boolean @default(false)

  /// What is left to spend in this cycle. Decremented atomically — see
  /// `spendCredits`, which guards on this column rather than reading it first.
  creditsRemaining Int @default(0)

  /// What this cycle started with, so the UI can draw a meter rather than a
  /// bare number, and so a support question can tell a grant from a top-up.
  creditsGranted Int @default(0)

  /// The window the grant belongs to. A cycle whose end has passed is refilled
  /// on the next read — see `ensureCycle` — which is what makes the monthly
  /// free allowance work with no cron job to forget to run.
  cycleStart DateTime @default(now())
  cycleEnd   DateTime

  /// Whether the one-time joining credits have been handed out. A boolean and
  /// not a date, because the only question ever asked of it is whether it has
  /// happened, and a nullable date invites a second meaning nobody defined.
  welcomeGranted Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usage UsageEvent[]
}

/// What a credit was spent on.
///
/// The names are the *priced* actions rather than the technical ones: the app
/// has one chat path and one document path, but a frontier answer costs five
/// times a fast one and a scanned page costs many times a digital one, so the
/// meter has to be able to tell them apart. Anything not listed here is free
/// and is not written down — notes, boards, todos and annotations cost nothing
/// to serve and are unmetered on every plan, including free.
enum UsageKind {
  CHAT_FAST
  CHAT_FRONTIER
  DOCUMENT
  OCR
}

/// One priced action, as it happened.
///
/// The audit trail, and the thing the app has never had: until this table
/// existed there was no way to answer "what did this account cost us" or "is
/// the credit price of a message anywhere near its real price". Tokens are
/// recorded beside the credits precisely so those two can be compared — the
/// credit table is a guess until a few weeks of these rows turn it into a
/// measurement.
///
/// Written after the work, never before, and never in the same statement as the
/// debit. A debit that succeeded and a run that then failed is a user who paid
/// for nothing, which is why `spendCredits` takes a refund path — see there.
model UsageEvent {
  id      String         @id @default(cuid())
  userId  String
  account BillingAccount @relation(fields: [userId], references: [userId], onDelete: Cascade)

  kind    UsageKind
  credits Int

  /// Which model actually answered, as opposed to which one was asked for.
  /// The fallback chain can change this without the user doing anything, and a
  /// bill that blames the wrong provider is a bill nobody can reconcile.
  provider String?
  model    String?

  inputTokens  Int?
  outputTokens Int?

  /// What it was about, when there is something to point at. Plain columns
  /// rather than relations: a usage row must survive the document or chat it
  /// describes being deleted, or the ledger develops holes exactly where
  /// somebody is most likely to be querying it.
  documentId String?
  chatId     String?

  createdAt DateTime @default(now())

  /// The two questions this table is asked: what has this account spent
  /// lately, and what did the whole product spend on a given day.
  @@index([userId, createdAt])
  @@index([createdAt])
}
